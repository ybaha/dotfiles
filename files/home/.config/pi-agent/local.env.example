# Machine- and network-specific values for the Pi agent stack.
# install.sh copies this to ~/.config/pi-agent/local.env; fill it in there.
# Never commit local.env. Scripts only read these when the variable is not already set.

# Nextcloud AI-Inbox (send-to-phone): base URL, and the SSH target that mints app passwords.
NC_AGENT_URL=https://home.your-tailnet.ts.net
NC_HOME_SSH=root@home.your-tailnet.ts.net
