#!/usr/bin/env bash
# Scheduled dotfiles push: a Pi agent reviews the committed work and pushes it to origin/<branch>.
# Runs from launchd (local.pi-dotfiles-push) at 19:00 local time. Safe to run by hand.
set -uo pipefail

REPO="${PI_DOTFILES_REPO:-$HOME/code/dotfiles}"
BRANCH="${PI_DOTFILES_BRANCH:-master}"
LOG="${PI_DOTFILES_PUSH_LOG:-$HOME/.local/state/pi-dotfiles-push.log}"
mkdir -p "$(dirname "$LOG")"

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >>"$LOG"; }

cd "$REPO" || { log "FAIL repo missing: $REPO"; exit 1; }

current="$(git branch --show-current)"
[ "$current" = "$BRANCH" ] || { log "SKIP on branch $current (expected $BRANCH)"; exit 0; }

# Secrets and runtime state must never be pushed.
if git diff --cached --name-only | grep -qiE '(auth\.json|telegram-bot-token|chief\.sqlite|\.env$|\.env\.local)'; then
	log "FAIL staged secret-like file; refusing to push"
	exit 1
fi

ahead="$(git rev-list --count "origin/$BRANCH..HEAD" 2>/dev/null || echo 0)"
[ "$ahead" != "0" ] || { log "SKIP nothing to push"; exit 0; }
log "START ahead=$ahead branch=$BRANCH"

# The agent decides whether the push is safe. It may only push commits that are already made.
push_ok=0
# launchd's PATH is minimal, so look for pi where it actually lives.
pi_bin="$(command -v pi 2>/dev/null || true)"
if [[ -z "$pi_bin" ]]; then
	for candidate in "$HOME/.local/bin/pi" "$HOME"/.nvm/versions/node/*/bin/pi /opt/homebrew/bin/pi /usr/local/bin/pi; do
		[[ -x "$candidate" ]] && { pi_bin="$candidate"; break; }
	done
fi
if [[ -x "$pi_bin" ]]; then
	# pi is a node script; launchd's PATH has no node, so put pi's own bin dir first.
	export PATH="$(dirname "$pi_bin"):$PATH"
	log "using agent pi: $pi_bin"
	prompt="You are pushing the dotfiles repository at $REPO to origin/$BRANCH.
The work is already committed ($ahead commit(s) ahead). Do exactly this:
1. Run 'git -C $REPO log --oneline origin/$BRANCH..HEAD' and 'git -C $REPO diff --stat origin/$BRANCH..HEAD' and check nothing secret-looking or generated is included.
2. Run the chief package tests: 'bash $REPO/files/home/.pi/agent/chief-of-staff/test/run.sh'.
3. If both look good, run 'git -C $REPO push origin $BRANCH'. Never use --force, never push tags, never rewrite history.
4. Report one line: what you pushed and whether the tests passed.
If the tests fail or the diff looks wrong, do NOT push; report the problem instead."
	model_args=()
	[[ -n "${PI_DOTFILES_PUSH_MODEL:-}" ]] && model_args=(--model "$PI_DOTFILES_PUSH_MODEL")
	if perl -e 'alarm 900; exec @ARGV' "$pi_bin" --mode json "${model_args[@]}" "$prompt" >>"$LOG.agent" 2>&1; then
		push_ok=1
		log "AGENT ran (see $LOG.agent)"
	else
		log "AGENT failed or timed out (see $LOG.agent)"
	fi
fi

# Fallback: the commit was already reviewed before this job was scheduled, so a plain push is safe.
if [ "$push_ok" != "1" ]; then
	if git push origin "$BRANCH" >>"$LOG" 2>&1; then
		log "FALLBACK pushed $BRANCH"
	else
		log "FAIL push failed"
		exit 1
	fi
fi

log "DONE $(git rev-parse --short HEAD) origin/$BRANCH=$(git rev-list --count "origin/$BRANCH..HEAD" 2>/dev/null || echo '?')"
